PORT=5000

# 1. MongoDB Atlas Connection
# Replace <username>, <password>, and cluster info with your actual Atlas details.
# KEEP "echostream" at the end, so it creates the database correctly!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/echostream?retryWrites=true&w=majority

# 2. Security
# Change this to a very long, random string in production!
JWT_SECRET=YOUR_VERY_SECURE_RANDOM_SECRET_STRING

# 3. Music APIs
MUSIC_API_BASE_URL=https://api.jamendo.com/v3.0
MUSIC_API_CLIENT_ID=56b49247

# 4. Email Configuration (SMTP)
# Change EMAIL_MODE to smtp so real emails are sent for Password Resets
EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Provide your actual email address
SMTP_USER=your-email@gmail.com
# Use an "App Password" (not your normal password) if using Gmail!
SMTP_PASSWORD=your-google-app-password
MAIL_FROM=your-email@gmail.com
